# Canon CIO Command Center - Environment Variables
# All values are optional since the app uses mocked data.

# Application title displayed in the browser tab and header
VITE_APP_TITLE=Canon CIO Command Center

# API base URL (unused — app uses mocked data by default)
VITE_API_BASE_URL=

# Enable or disable mock data (true by default)
VITE_USE_MOCK_DATA=true

# Log level for development (debug, info, warn, error)
VITE_LOG_LEVEL=info